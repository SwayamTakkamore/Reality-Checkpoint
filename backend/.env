# 1. Run with Google Gemma 4 (Default)
HF_MODEL_ID="google/gemma-4-E2B-it" ./start.sh

# 2. Run with an ultra-lightweight edge model for fast CPU testing (e.g. SmolLM)
HF_MODEL_ID="HuggingFaceTB/SmolLM-135M-Instruct" ./start.sh

# 3. Force instant deterministic heuristic mode (0s cold start, zero GPU/RAM overhead)
REALITY_DISABLE_HF=1 ./start.sh
